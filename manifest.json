{
  "name": "YouTube Ad Auto-skipper — Firefox fork",
  "short_name": "YouTube Ad Auto-skipper",
  "description": "Firefox fork of Shreya Dahal's YouTube Ad Auto-skipper. Automatically skip available ads, mute ads, and restore the previous audio state.",
  "manifest_version": 2,
  "version": "0.6.5",
  "author": "Shreya Dahal (original); Justin Luque (Firefox fork)",
  "homepage_url": "https://github.com/justinluque/yt-ad-autoskipper",
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*"
      ],
      "js": [
        "mutead.js",
        "skipad.js"
      ],
      "run_at": "document_end",
      "all_frames": true
    },
    {
      "matches": [
        "*://*.youtube.com/*"
      ],
      "js": [
        "youtube_override.js"
      ],
      "all_frames": true,
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "64": "icons/64.png",
    "96": "icons/96.png",
    "128": "logo.png"
  },
  "permissions": [
    "storage"
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "browser_specific_settings": {
    "gecko": {
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
