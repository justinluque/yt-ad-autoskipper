{
  "name": "YouTube Ad Auto-skipper",
  "short_name": "YouTube Ad Auto-skipper",
  "description": "YouTube Ad Skipper is an extension that auto skips ads after YouTube provides a skip ad button. It does not block an ad.",
  "manifest_version": 2,
  "version": "0.6.1",
  "author": "Shreya Dahal",
  "homepage_url": "https://github.com/squgeim/yt-ad-autoskipper",
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*"
      ],
      "js": [
        "mutead.js",
        "skipad.js"
      ],
      "run_at": "document_end",
      "all_frames": true
    },
    {
      "matches": [
        "*://*.youtube.com/*"
      ],
      "js": [
        "youtube_override.js"
      ],
      "all_frames": true,
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "icons": {
    "128": "logo.png"
  },
  "permissions": [
    "storage"
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "browser_specific_settings": {
    "gecko": {
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
